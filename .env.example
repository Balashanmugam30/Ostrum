# ==============================================================================
# OSTRUM Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env.local` for local development.
# - NEVER commit `.env.local`, API keys, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND TRANSACTIONAL EMAIL SERVICE (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Server-only API key from Resend dashboard (https://resend.com/api-keys).
# Never prefix with NEXT_PUBLIC_ and never commit its value.
RESEND_API_KEY=

# Server-only notification recipient. Must be an actual mailbox that can receive email.
# Official studio mailbox: hello@theostrum.tech
OSTRUM_ENQUIRY_TO=hello@theostrum.tech

# Server-only verified sender identity in Resend.
# Must be a domain verified with DKIM/SPF in Resend (e.g., website@theostrum.tech).
# In local development without a verified domain, Resend requires onboarding@resend.dev for test sends.
OSTRUM_ENQUIRY_FROM=OSTRUM Website <website@theostrum.tech>

# ------------------------------------------------------------------------------
# 2. PUBLIC SITE & BRAND DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Public site base URL. Canonical origin https://www.theostrum.tech.
NEXT_PUBLIC_SITE_URL=https://www.theostrum.tech

# ------------------------------------------------------------------------------
# 3. COMPANY LINKEDIN PROFILE (PUBLIC)
# ------------------------------------------------------------------------------
# Canonical LinkedIn company page URL supplied by the owner.
NEXT_PUBLIC_OSTRUM_LINKEDIN_URL=https://www.linkedin.com/company/ostrum/

# ------------------------------------------------------------------------------
# 4. DISTRIBUTED RATE LIMITING (SERVER-ONLY, OPTIONAL)
# ------------------------------------------------------------------------------
# Upstash Redis REST credentials (or Vercel KV) for distributed abuse protection.
# If omitted, local process sliding-window memory circuit breaker operates automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
