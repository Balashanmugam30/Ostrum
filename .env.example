# ==============================================================================
# OSTRUM Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Copy this file to `.env.local` for local development.
# - NEVER commit `.env.local`, API keys, or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RESEND TRANSACTIONAL EMAIL SERVICE (SERVER-ONLY)
# ------------------------------------------------------------------------------
# Server-only API key from Resend dashboard (https://resend.com/api-keys).
# Never prefix with NEXT_PUBLIC_ and never commit its value.
RESEND_API_KEY=

# Server-only notification recipient. Must be an actual mailbox that can receive email.
# The owner intends to provision hello@theostrum.com once domain purchase and MX records are complete.
OSTRUM_ENQUIRY_TO=hello@theostrum.com

# Server-only verified sender identity in Resend.
# Must be a domain verified with DKIM/SPF in Resend (e.g., website@theostrum.com).
# In local development without a verified domain, Resend requires onboarding@resend.dev for test sends.
OSTRUM_ENQUIRY_FROM=OSTRUM Website <website@theostrum.com>

# ------------------------------------------------------------------------------
# 2. PUBLIC SITE & BRAND DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# Public site base URL. Set to the real canonical origin once the domain is purchased and configured.
NEXT_PUBLIC_SITE_URL=https://theostrum.com

# ------------------------------------------------------------------------------
# 3. COMPANY LINKEDIN PROFILE (PUBLIC)
# ------------------------------------------------------------------------------
# Placeholder only. Replace with the official company page after it is created.
# While unset or matching this placeholder, the studio footer displays an accessible "Pending" badge.
NEXT_PUBLIC_OSTRUM_LINKEDIN_URL=https://www.linkedin.com/company/replace-with-real-ostrum-profile/
